<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Paul Vick</Authors>
    <Company>Paul Vick</Company>
    <Description>SDL3 bindings for .NET 10, including graphics, audio, and input.</Description>
    <Copyright>Copyright 2019-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SdlSharp.ImGui" />
    <InternalsVisibleTo Include="SdlSharp.Tests" />
    <InternalsVisibleTo Include="SdlSharp.ImGui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SdlSharp.Redist" Version="1.0.1" />
  </ItemGroup>

</Project>
